# Copie este arquivo para .Renviron (mesma pasta) e preencha.
# O .Renviron fica fora do Git: nunca suba senha para o repositório.
# Depois de editar, reinicie o R (no RStudio: Session > Restart R).

# Conexão com o banco (obrigatórias):
OFTALMO_DB_USER=
OFTALMO_DB_PASSWORD=

# Conexão com o banco (opcionais; os valores abaixo são o padrão):
# OFTALMO_DB_HOST=192.168.1.204
# OFTALMO_DB_PORT=3306
# OFTALMO_DB_NAME=cevesp_2k17

# Intervalo de atualização automática dos dados, em minutos (padrão 5):
# OFTALMO_REFRESH_MINUTES=5
# Anos fora do canal endêmico (padrão 2011,2020,2021) e janela de anos históricos (padrão 10):
# OFTALMO_CANAL_ANOS_EXCLUIDOS=2011,2020,2021
# OFTALMO_CANAL_JANELA=10
# Coluna do banco com o código IBGE do município, se existir:
# OFTALMO_COL_COD_IBGE=
